{
  "name": "cloudflare-cost-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare R2 / Workers / D1 の利用料金を事前に試算するWebツール",
  "scripts": {
    "test": "node --test tests/pricing.test.mjs && vitest run --dir tests --exclude=**/*.mjs",
    "check": "tsc --noEmit",
    "dev": "wrangler dev --local --persist-to .wrangler/state --var ENVIRONMENT:local",
    "serve": "python3 -m http.server 4178 -d public",
    "db:migrate:local": "wrangler d1 migrations apply SESSIONS --local --persist-to .wrangler/state"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
